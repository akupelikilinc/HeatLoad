<Window x:Class="HeatLoad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeatLoad" Width="382" Height="124"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Border x:Name="Card" Margin="10" CornerRadius="20" BorderThickness="1" BorderBrush="#1CFFFFFF">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F0151923" Offset="0" />
                    <GradientStop Color="#F0090B10" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#000000" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform Y="8" />
            </Border.RenderTransform>

            <!-- Right-click anywhere on the card: hide / mode / settings / quit. -->
            <Border.ContextMenu>
                <ContextMenu x:Name="HudMenu">
                    <MenuItem x:Name="HideItem" Header="Göstergeyi gizle" Click="Hide_Click" />
                    <MenuItem x:Name="TempItem" Header="Sıcaklıkları göster" IsCheckable="True" Click="TempMode_Click" />
                    <MenuItem Header="Ayarlar…" Click="Settings_Click" />
                    <Separator />
                    <MenuItem Header="Çıkış" Click="Exit_Click" />
                </ContextMenu>
            </Border.ContextMenu>

            <Grid Margin="18,10,18,13">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock x:Name="ModeLabel" Text="KULLANIM" FontSize="9" FontWeight="SemiBold"
                               Foreground="#5E6878" VerticalAlignment="Center" />
                    <Button x:Name="SwapButton" Click="Swap_Click" Cursor="Hand" Width="18" Height="18"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            ToolTip="Büyük değeri değiştir (kullanım / sıcaklık)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="9" Background="Transparent">
                                    <TextBlock Text="&#x21C4;" FontSize="12" Foreground="#8A93A3"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- CPU -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="3" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="CPU" FontSize="10" FontWeight="SemiBold" Foreground="#7C8798" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="CpuDot" Width="4" Height="4" Fill="#5BC8FF" Margin="0,0,4,0" />
                                <TextBlock x:Name="CpuSub" Text="—" FontSize="10.5" Foreground="#9AA4B3" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                            <TextBlock x:Name="CpuValue" Text="—" FontSize="27" FontWeight="SemiBold" Foreground="#F2F6FC"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" Typography.NumeralAlignment="Tabular" />
                            <TextBlock x:Name="CpuUnit" Text="%" FontSize="11" Foreground="#6E7788"
                                       VerticalAlignment="Bottom" Margin="2,0,0,4" />
                        </StackPanel>
                        <Border Grid.Row="2" CornerRadius="1.5" Background="#16FFFFFF" ClipToBounds="True">
                            <Border x:Name="CpuBar" Background="#5BC8FF" CornerRadius="1.5" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Grid>

                    <!-- GPU -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="3" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="GPU" FontSize="10" FontWeight="SemiBold" Foreground="#7C8798" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="GpuDot" Width="4" Height="4" Fill="#6FE7B7" Margin="0,0,4,0" />
                                <TextBlock x:Name="GpuSub" Text="—" FontSize="10.5" Foreground="#9AA4B3" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                            <TextBlock x:Name="GpuValue" Text="—" FontSize="27" FontWeight="SemiBold" Foreground="#F2F6FC"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" Typography.NumeralAlignment="Tabular" />
                            <TextBlock x:Name="GpuUnit" Text="%" FontSize="11" Foreground="#6E7788"
                                       VerticalAlignment="Bottom" Margin="2,0,0,4" />
                        </StackPanel>
                        <Border Grid.Row="2" CornerRadius="1.5" Background="#16FFFFFF" ClipToBounds="True">
                            <Border x:Name="GpuBar" Background="#6FE7B7" CornerRadius="1.5" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Grid>

                    <!-- RAM -->
                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="3" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="RAM" FontSize="10" FontWeight="SemiBold" Foreground="#7C8798" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="RamDot" Width="4" Height="4" Fill="#B7A6FF" Margin="0,0,4,0" />
                                <TextBlock x:Name="RamSub" Text="—" FontSize="10.5" Foreground="#9AA4B3" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                            <TextBlock x:Name="RamValue" Text="—" FontSize="27" FontWeight="SemiBold" Foreground="#F2F6FC"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" Typography.NumeralAlignment="Tabular" />
                            <TextBlock x:Name="RamUnit" Text="%" FontSize="11" Foreground="#6E7788"
                                       VerticalAlignment="Bottom" Margin="2,0,0,4" />
                        </StackPanel>
                        <Border Grid.Row="2" CornerRadius="1.5" Background="#16FFFFFF" ClipToBounds="True">
                            <Border x:Name="RamBar" Background="#B7A6FF" CornerRadius="1.5" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
