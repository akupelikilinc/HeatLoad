<Window x:Class="HeatLoad.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeatLoad Ayarlar" Width="330" Height="264"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8A93A3" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="7" Background="Transparent" Padding="0,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0EFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                                <Setter Property="Foreground" Value="#F2F6FC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#5E6878" />
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="Card" Margin="14" CornerRadius="16" BorderThickness="1" BorderBrush="#1CFFFFFF"
                MouseLeftButtonDown="Card_MouseDown">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F0141821" Offset="0" />
                    <GradientStop Color="#F0090B10" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.55" Color="#000000" />
            </Border.Effect>

            <Grid Margin="18,14,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="HeatLoad" FontSize="13" FontWeight="SemiBold" Foreground="#EDF2F9" />
                        <TextBlock Text="Ayarlar" FontSize="11" Foreground="#6E7788" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="CloseButton" Click="Close_Click" Cursor="Hand" Width="20" Height="20" Focusable="False"
                            HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Kapat (Esc)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="10" Background="Transparent">
                                    <TextBlock Text="&#x2715;" FontSize="10" Foreground="#8A93A3"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#24FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,17,0,0">
                    <TextBlock Text="BÜYÜK DEĞER" Style="{StaticResource Caption}" />
                    <Border Background="#12FFFFFF" CornerRadius="9" Padding="3" Margin="0,7,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="UsageSegment" Grid.Column="0" Content="Kullanım"
                                         Style="{StaticResource Segment}" Checked="Mode_Click" />
                            <RadioButton x:Name="TempSegment" Grid.Column="1" Content="Sıcaklık"
                                         Style="{StaticResource Segment}" Checked="Mode_Click" />
                        </Grid>
                    </Border>

                    <TextBlock Text="AÇILIŞ" Style="{StaticResource Caption}" Margin="0,17,0,0" />
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="Açılışta başlat" FontSize="12" Foreground="#C9D2DF" VerticalAlignment="Center" />
                        <CheckBox x:Name="StartSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Checked="Start_Click" Unchecked="Start_Click" Focusable="False" />
                    </Grid>
                </StackPanel>

                <Button x:Name="QuitButton" Grid.Row="2" Click="Quit_Click" Cursor="Hand" Height="32" Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1CFFFFFF"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="Göstergeyi kapat" FontSize="11.5" FontWeight="SemiBold" Foreground="#C9D2DF" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
