<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HeatLoad.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />

        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="#F5141821" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style Selector="MenuItem">
            <Setter Property="Foreground" Value="#C9D2DF" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Inter" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style Selector="Button.icon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Bg" CornerRadius="9" Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.icon:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="#1FFFFFFF" />
        </Style>

        <Style Selector="RadioButton.segment">
            <Setter Property="Foreground" Value="#8A93A3" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Bg" CornerRadius="7" Background="Transparent" Padding="0,7">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.segment:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="#0EFFFFFF" />
        </Style>
        <Style Selector="RadioButton.segment:checked /template/ Border#Bg">
            <Setter Property="Background" Value="#1FFFFFFF" />
        </Style>
        <Style Selector="RadioButton.segment:checked">
            <Setter Property="Foreground" Value="#F2F6FC" />
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#5E6878" />
        </Style>

        <!-- Small pill switch for the settings window. -->
        <Style Selector="CheckBox.switch">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Track" Width="38" Height="22" CornerRadius="11"
                            Background="#1FFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                        <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="8" Background="#8A93A3"
                                HorizontalAlignment="Left" Margin="2,0,0,0" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox.switch:checked /template/ Border#Track">
            <Setter Property="Background" Value="#335BC8FF" />
            <Setter Property="BorderBrush" Value="#665BC8FF" />
        </Style>
        <Style Selector="CheckBox.switch:checked /template/ Border#Thumb">
            <Setter Property="Background" Value="#5BC8FF" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
        <Style Selector="CheckBox.switch:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </Application.Styles>
</Application>

