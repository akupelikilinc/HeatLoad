<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HeatLoad.MainWindow"
        Title="HeatLoad" Width="382" Height="124"
        Icon="avares://HeatLoad/Assets/app.png"
        SystemDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        TransparencyBackgroundFallback="#0B0E14"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        CanResize="False" WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI, Inter"
        UseLayoutRounding="True">

    <Grid>
        <Border x:Name="Card" Margin="10" CornerRadius="20" BorderThickness="1" BorderBrush="#1CFFFFFF"
                Cursor="SizeAll"
                BoxShadow="0 0 24 0 #80000000"
                PointerPressed="Card_PointerPressed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#F0151923" Offset="0" />
                    <GradientStop Color="#F0090B10" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <!-- Right-click anywhere on the card: hide / mode / settings / quit. -->
            <Border.ContextMenu>
                <ContextMenu x:Name="HudMenu">
                    <MenuItem x:Name="HideItem" Header="Göstergeyi gizle" Click="Hide_Click" />
                    <MenuItem x:Name="TempItem" Header="Sıcaklıkları göster" ToggleType="CheckBox" Click="TempMode_Click" />
                    <MenuItem x:Name="CompactItem" Header="Kompakt görünüm" ToggleType="CheckBox" Click="CompactMode_Click" />
                    <MenuItem Header="Ayarlar…" Click="Settings_Click" />
                    <Separator />
                    <MenuItem Header="Çıkış" Click="Exit_Click" />
                </ContextMenu>
            </Border.ContextMenu>

            <Grid x:Name="Root" Margin="18,10,18,13">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="FullHeader" Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock x:Name="ModeLabel" Text="KULLANIM" FontSize="9" FontWeight="SemiBold"
                               Foreground="#5E6878" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="ScaleButton" Classes="icon" Click="Scale_Click"
                                ToolTip.Tip="Kompakt görünüme geç">
                            <TextBlock x:Name="ScaleGlyph" Text="⤡" FontSize="12" Foreground="#A8B2C2" />
                        </Button>
                        <Button x:Name="SwapButton" Classes="icon" Click="Swap_Click" Margin="2,0,0,0"
                                ToolTip.Tip="Büyük değeri değiştir (kullanım / sıcaklık)">
                            <TextBlock Text="⇄" FontSize="12" Foreground="#8A93A3" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="FullBody" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- CPU -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="3" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="CPU" FontSize="10" FontWeight="SemiBold" Foreground="#7C8798" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="CpuDot" Width="4" Height="4" Fill="#5BC8FF" Margin="0,0,4,0" />
                                <TextBlock x:Name="CpuSub" Text="—" FontSize="10.5" Foreground="#9AA4B3" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                            <TextBlock x:Name="CpuValue" Text="—" FontSize="27" FontWeight="SemiBold" Foreground="#F2F6FC"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, Inter" />
                            <TextBlock x:Name="CpuUnit" Text="%" FontSize="11" Foreground="#6E7788"
                                       VerticalAlignment="Bottom" Margin="2,0,0,4" />
                        </StackPanel>
                        <Border Grid.Row="2" CornerRadius="1.5" Background="#16FFFFFF" ClipToBounds="True">
                            <Border x:Name="CpuBar" Background="#5BC8FF" CornerRadius="1.5" RenderTransformOrigin="0%,50%">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Grid>

                    <!-- GPU -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="3" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="GPU" FontSize="10" FontWeight="SemiBold" Foreground="#7C8798" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="GpuDot" Width="4" Height="4" Fill="#6FE7B7" Margin="0,0,4,0" />
                                <TextBlock x:Name="GpuSub" Text="—" FontSize="10.5" Foreground="#9AA4B3" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                            <TextBlock x:Name="GpuValue" Text="—" FontSize="27" FontWeight="SemiBold" Foreground="#F2F6FC"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, Inter" />
                            <TextBlock x:Name="GpuUnit" Text="%" FontSize="11" Foreground="#6E7788"
                                       VerticalAlignment="Bottom" Margin="2,0,0,4" />
                        </StackPanel>
                        <Border Grid.Row="2" CornerRadius="1.5" Background="#16FFFFFF" ClipToBounds="True">
                            <Border x:Name="GpuBar" Background="#6FE7B7" CornerRadius="1.5" RenderTransformOrigin="0%,50%">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Grid>

                    <!-- RAM -->
                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="3" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="RAM" FontSize="10" FontWeight="SemiBold" Foreground="#7C8798" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="RamDot" Width="4" Height="4" Fill="#B7A6FF" Margin="0,0,4,0" />
                                <TextBlock x:Name="RamSub" Text="—" FontSize="10.5" Foreground="#9AA4B3" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                            <TextBlock x:Name="RamValue" Text="—" FontSize="27" FontWeight="SemiBold" Foreground="#F2F6FC"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, Inter" />
                            <TextBlock x:Name="RamUnit" Text="%" FontSize="11" Foreground="#6E7788"
                                       VerticalAlignment="Bottom" Margin="2,0,0,4" />
                        </StackPanel>
                        <Border Grid.Row="2" CornerRadius="1.5" Background="#16FFFFFF" ClipToBounds="True">
                            <Border x:Name="RamBar" Background="#B7A6FF" CornerRadius="1.5" RenderTransformOrigin="0%,50%">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Compact: just the three numbers, colour-coded; text and colours mirror the full view. -->
                <Grid x:Name="CompactBody" Grid.Row="1" IsVisible="False" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="4" Height="4" Margin="0,0,5,0" Fill="{Binding Fill, ElementName=CpuDot}" />
                        <TextBlock Text="{Binding Text, ElementName=CpuValue}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{Binding Foreground, ElementName=CpuValue}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, Inter" />
                        <TextBlock Text="{Binding Text, ElementName=CpuUnit}" FontSize="9" Foreground="#6E7788"
                                   VerticalAlignment="Bottom" Margin="1,0,0,2" />

                        <Ellipse Width="4" Height="4" Margin="14,0,5,0" Fill="{Binding Fill, ElementName=GpuDot}" />
                        <TextBlock Text="{Binding Text, ElementName=GpuValue}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{Binding Foreground, ElementName=GpuValue}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, Inter" />
                        <TextBlock Text="{Binding Text, ElementName=GpuUnit}" FontSize="9" Foreground="#6E7788"
                                   VerticalAlignment="Bottom" Margin="1,0,0,2" />

                        <Ellipse Width="4" Height="4" Margin="14,0,5,0" Fill="{Binding Fill, ElementName=RamDot}" />
                        <TextBlock Text="{Binding Text, ElementName=RamValue}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{Binding Foreground, ElementName=RamValue}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, Inter" />
                        <TextBlock Text="{Binding Text, ElementName=RamUnit}" FontSize="9" Foreground="#6E7788"
                                   VerticalAlignment="Bottom" Margin="1,0,0,2" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Classes="icon" Width="16" Height="16" Click="Swap_Click"
                                ToolTip.Tip="Büyük değeri değiştir (kullanım / sıcaklık)">
                            <TextBlock Text="⇄" FontSize="11" Foreground="#8A93A3" />
                        </Button>
                        <Button Classes="icon" Width="16" Height="16" Click="Scale_Click" Margin="2,0,0,0"
                                ToolTip.Tip="Tam görünüme dön">
                            <TextBlock Text="⤢" FontSize="11" Foreground="#A8B2C2" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
